{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ezpk",
  "main": "./worker.js",
  "compatibility_date": "2026-07-17",

  // v437 single-alliance production configuration. EZPK2 hostname remains routed only so the Worker can archive/redirect legacy traffic; the EZPK2 D1 database is intentionally not bound.
  "routes": [
    { "pattern": "ezpk322.com", "custom_domain": true },
    { "pattern": "ezpk1.ezpk322.com", "custom_domain": true },
    { "pattern": "ezpk2.ezpk322.com", "custom_domain": true }
  ],

  "vars": {
    "SITE_MODE": "SINGLE",
    "EZPK2_STATUS": "ARCHIVED",
    "EZPK1_MIGRATION_INTAKE": "ENABLED",
    "EZPK2_MIGRATION_INTAKE": "DISABLED"
  },

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ezpk-members",
      "database_id": "aaa29a3a-a221-47e3-a30f-9b4c624dcb56",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "logs": { "enabled": true } }
}
