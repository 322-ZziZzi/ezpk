{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ezpk",
  "main": "./worker.js",
  "compatibility_date": "2026-07-17",

  // v409 multi-alliance production configuration with Worker-first host routing.
  // EZPK2 database_id resolved from the operator-provided Cloudflare D1 UUID.
  "routes": [
    { "pattern": "ezpk322.com", "custom_domain": true },
    { "pattern": "ezpk1.ezpk322.com", "custom_domain": true },
    { "pattern": "ezpk2.ezpk322.com", "custom_domain": true }
  ],

  "vars": {
    "SITE_MODE": "DUAL",
    "EZPK2_STATUS": "ACTIVE",
    "EZPK1_MIGRATION_INTAKE": "ENABLED",
    "EZPK2_MIGRATION_INTAKE": "DISABLED"
  },

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ezpk-members",
      "database_id": "aaa29a3a-a221-47e3-a30f-9b4c624dcb56",
      "migrations_dir": "migrations"
    },
    {
      "binding": "EZPK2_DB",
      "database_name": "ezpk2-members",
      "database_id": "7203fea0-0dd3-4332-9c11-44273355a4bb",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "logs": { "enabled": true } }
}
