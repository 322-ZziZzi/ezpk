{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ezpk",
  "main": "./worker.js",
  "compatibility_date": "2026-07-17",

  "routes": [
    {
      "pattern": "ezpk322.com",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/data/capital-war.json",
      "/data/season6-teams.json",
      "/data/bgb.json"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ezpk-members",
      "database_id": "aaa29a3a-a221-47e3-a30f-9b4c624dcb56",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
