{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ezpk",
  "main": "./worker.js",
  "compatibility_date": "2026-07-17",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ezpk-members",
      "database_id": "aaa29a3a-a221-47e3-a30f-9b4c624dcb56",
      "migrations_dir": "migrations"
    }
  ]
}
