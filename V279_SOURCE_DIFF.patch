+/* v279: final desktop card navigation and mobile accordion navigation */
+.admin-hero{padding-bottom:26px}
+.manager-card{padding:24px}
+.admin-card-navigation{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-bottom:26px}
+.admin-nav-card{min-width:0;padding:18px;border:1px solid rgba(255,255,255,.09);border-radius:16px;background:linear-gradient(180deg,rgba(21,31,46,.96),rgba(12,19,29,.96));box-shadow:0 14px 32px rgba(0,0,0,.18);transition:border-color .18s ease,transform .18s ease,box-shadow .18s ease}
+.admin-nav-card:hover{transform:translateY(-2px);border-color:rgba(245,197,71,.28);box-shadow:0 18px 38px rgba(0,0,0,.25)}
+.admin-nav-card-toggle{display:flex;width:100%;align-items:center;justify-content:space-between;min-height:40px;padding:0 4px 13px;border:0;border-bottom:1px solid rgba(255,255,255,.08);background:transparent;color:#f4f6f8;font-size:16px;font-weight:900;text-align:left;cursor:default}
+.admin-nav-chevron{display:none;color:#8d99aa;font-size:17px;transition:transform .18s ease}
+.admin-nav-card-items{display:grid;gap:6px;padding-top:12px}
+.admin-nav-card-items button{display:flex;align-items:center;width:100%;min-height:44px;padding:0 13px;border:1px solid transparent;border-radius:10px;background:transparent;color:#aeb8c6;font-size:14px;font-weight:800;text-align:left;cursor:pointer;transition:background .16s ease,color .16s ease,border-color .16s ease}
+.admin-nav-card-items button:hover{background:rgba(255,255,255,.055);color:#fff}
+.admin-nav-card-items button.active{border-color:rgba(245,197,71,.22);background:rgba(245,197,71,.11);color:#f5c547}
+.admin-panel{animation:adminPanelFade .16s ease}
+@keyframes adminPanelFade{from{opacity:.35}to{opacity:1}}
+
+@media(max-width:760px){
+  .admin-hero{padding:44px 16px 24px}
+  .admin-hero h1{font-size:clamp(34px,11vw,48px)}
+  .manager-card{width:calc(100% - 24px);padding:14px;border-radius:15px}
+  .admin-card-navigation{grid-template-columns:1fr;gap:10px;margin-bottom:18px}
+  .admin-nav-card{padding:0;border-radius:14px;transform:none!important;box-shadow:none}
+  .admin-nav-card-toggle{min-height:54px;padding:0 16px;border-bottom:0;cursor:pointer}
+  .admin-nav-chevron{display:block}
+  .admin-nav-card.open .admin-nav-chevron{transform:rotate(180deg)}
+  .admin-nav-card-items{display:none;padding:0 9px 10px}
+  .admin-nav-card.open .admin-nav-card-items{display:grid}
+  .admin-nav-card.open .admin-nav-card-toggle{border-bottom:1px solid rgba(255,255,255,.08)}
+  .admin-nav-card-items button{min-height:46px;padding:0 13px}
+}
